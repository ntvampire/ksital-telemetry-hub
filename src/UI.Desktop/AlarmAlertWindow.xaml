<Window x:Class="KsitalTelemetryHub.UI.Desktop.AlarmAlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ВНИМАНИЕ! ТРЕВОГА НА ОБЪЕКТЕ" Height="480" Width="680"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="{DynamicResource BgMain}" Foreground="{DynamicResource TextMain}"
        BorderBrush="#F38BA8" BorderThickness="3" WindowStyle="None">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка окна тревоги -->
        <Border Grid.Row="0" Background="#F38BA8" CornerRadius="6" Padding="12,10" Margin="0,0,0,15">
            <DockPanel>
                <TextBlock Text="🚨 ТЕХНОЛОГИЧЕСКАЯ АВАРИЯ / СРАБОТКА" Foreground="#11111B" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Content="✕" Click="BtnClose_Click" ToolTip="Отложить на 5 минут"
                        DockPanel.Dock="Right" HorizontalAlignment="Right"
                        Width="32" Height="30" Background="#E78284" Foreground="#11111B"
                        FontWeight="Bold" FontSize="15" BorderThickness="0" Cursor="Hand"/>
            </DockPanel>
        </Border>

        <!-- Карточка сведений о тревоге и объекте -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" CornerRadius="8" Padding="16">
            <StackPanel>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Время события:" Foreground="{DynamicResource TextMuted}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtTimestamp" Grid.Column="1" Text="--" Foreground="#F9E2AF" FontSize="15" FontWeight="Bold"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Объект:" Foreground="{DynamicResource TextMuted}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtObjectName" Grid.Column="1" Text="--" Foreground="#89B4FA" FontSize="17" FontWeight="Bold"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Участок:" Foreground="{DynamicResource TextMuted}" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock x:Name="TxtDistrict" Grid.Column="1" Text="--" Foreground="{DynamicResource TextMain}" FontSize="14"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Телефон / Тип:" Foreground="{DynamicResource TextMuted}" FontSize="14" FontWeight="SemiBold"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock x:Name="TxtPhone" Text="--" Foreground="{DynamicResource TextMain}" FontSize="14" Margin="0,0,10,0"/>
                        <TextBlock x:Name="TxtDeviceType" Text="--" Foreground="#CBA6F7" FontSize="13" FontWeight="Bold"/>
                    </StackPanel>
                </Grid>

                <Separator Background="{DynamicResource BorderColor}" Margin="0,5,0,12"/>

                <TextBlock Text="Описание неисправности / тревоги:" Foreground="{DynamicResource TextMuted}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6"/>
                <Border Background="{DynamicResource BgInner}" CornerRadius="6" Padding="12" MinHeight="90">
                    <TextBlock x:Name="TxtAlarmDescription" Text="--" TextWrapping="Wrap"
                               Foreground="#F38BA8" FontSize="16" FontWeight="Bold"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Нижняя панель с кнопками действий -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Content="✅ ПОДТВЕРДИТЬ ТРЕВОГУ" Click="BtnConfirm_Click"
                    Height="44" Background="#A6E3A1" Foreground="#11111B" FontSize="15" FontWeight="Bold"
                    BorderThickness="0" Cursor="Hand" Margin="0,0,10,0"/>

            <Button Grid.Column="1" Content="⏱ Закрыть (повтор через 5 мин)" Click="BtnClose_Click"
                    Height="44" Padding="16,0" Background="#45475A" Foreground="#CDD6F4" FontSize="13" FontWeight="SemiBold"
                    BorderThickness="0" Cursor="Hand"/>
        </Grid>
    </Grid>
</Window>