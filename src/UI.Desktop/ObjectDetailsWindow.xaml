<Window x:Class="KsitalTelemetryHub.UI.Desktop.ObjectDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Карточка объекта и телеуправление" Height="640" Width="820"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgMain}" Foreground="{DynamicResource TextMain}"
        FontSize="13">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock x:Name="TxtHeaderTitle" Text="Параметры объекта" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- Основные реквизиты -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" CornerRadius="8" Padding="14" Margin="0,0,0,14" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtName" Grid.Row="0" Grid.Column="1" Height="30" Margin="0,0,10,8" Padding="6,2"
                         Background="{DynamicResource BgInner}" Foreground="{DynamicResource TextMain}" BorderBrush="{DynamicResource BorderColor}"/>

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Участок/Район:" VerticalAlignment="Center" Margin="10,0,0,8"/>
                <TextBox x:Name="TxtDistrict" Grid.Row="0" Grid.Column="3" Height="30" Margin="0,0,0,8" Padding="6,2"
                         Background="{DynamicResource BgInner}" Foreground="{DynamicResource TextMain}" BorderBrush="{DynamicResource BorderColor}"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Телефон SIM:" VerticalAlignment="Center" Margin="0,0,0,8"/>
                <TextBox x:Name="TxtPhone" Grid.Row="1" Grid.Column="1" Height="30" Margin="0,0,10,8" Padding="6,2"
                         Background="{DynamicResource BgInner}" Foreground="{DynamicResource TextMain}" BorderBrush="{DynamicResource BorderColor}"/>

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Тип контроллера:" VerticalAlignment="Center" Margin="10,0,0,8"/>
                <ComboBox x:Name="CmbDeviceType" Grid.Row="1" Grid.Column="3" Height="30" Margin="0,0,0,8"
                          SelectionChanged="CmbDeviceType_SelectionChanged"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Пароль SMS:" VerticalAlignment="Center"/>
                <TextBox x:Name="TxtPassword" Grid.Row="2" Grid.Column="1" Height="30" Margin="0,0,10,0" Padding="6,2"
                         Background="{DynamicResource BgInner}" Foreground="{DynamicResource TextMain}" BorderBrush="{DynamicResource BorderColor}"
                         TextChanged="TxtPassword_TextChanged"/>

                <TextBlock Grid.Row="2" Grid.Column="2" Text="Примечание:" VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBox x:Name="TxtDescription" Grid.Row="2" Grid.Column="3" Height="30" Padding="6,2"
                         Background="{DynamicResource BgInner}" Foreground="{DynamicResource TextMain}" BorderBrush="{DynamicResource BorderColor}"/>
            </Grid>
        </Border>

        <!-- Блок команд телеуправления -->
        <GroupBox Grid.Row="2" Header="Диспетчерские команды и запросы" Foreground="{DynamicResource TextMain}" FontWeight="Bold">
            <Grid Margin="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Быстрые шаблоны -->
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <TextBlock Text="Готовые шаблоны команд для выбранного оборудования:" FontWeight="Normal" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
                    <ComboBox x:Name="CmbTemplates" Height="32" SelectionChanged="CmbTemplates_SelectionChanged"/>
                </StackPanel>

                <!-- Поле редактирования текста SMS перед отправкой -->
                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="180"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtPayload" Height="34" Padding="8,4" FontSize="14" FontWeight="Bold"
                             Background="{DynamicResource BgInner}" Foreground="{DynamicResource TextMain}" BorderBrush="{DynamicResource BorderColor}"/>
                    <Button Grid.Column="1" Content="✉ Отправить команду" Click="BtnSendCommand_Click" Margin="10,0,0,0"
                            Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </Grid>

                <!-- Журнал команд -->
                <TextBlock Grid.Row="2" Text="История отправленных запросов:" FontWeight="Normal" Foreground="{DynamicResource TextMuted}" Margin="0,4,0,4"/>
                <DataGrid x:Name="GridCommands" Grid.Row="3" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="{DynamicResource BgInner}" RowBackground="{DynamicResource BgCard}"
                          Foreground="{DynamicResource TextMain}" BorderBrush="{DynamicResource BorderColor}"
                          HeadersVisibility="Column" SelectionMode="Single" RowHeight="26">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время" Binding="{Binding CreatedAt, StringFormat=\{0:dd.MM.yyyy HH:mm:ss\}}" Width="140"/>
                        <DataGridTextColumn Header="Текст команды" Binding="{Binding RawPayload}" Width="*"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="200"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </GroupBox>

        <!-- Нижние кнопки сохранения карточки -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Отмена" Click="BtnCancel_Click" Width="110" Height="34" Margin="0,0,10,0"
                    Background="{DynamicResource BgInner}" Foreground="{DynamicResource TextMain}" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Сохранить объект" Click="BtnSave_Click" Width="160" Height="34"
                    Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>