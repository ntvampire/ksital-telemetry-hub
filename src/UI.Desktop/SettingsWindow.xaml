<Window x:Class="KsitalTelemetryHub.UI.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки системы" Height="650" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource BgMain}" Foreground="{DynamicResource TextMain}"
        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Grid.Row="0" Text="Параметры подключения и системы" 
                   FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextMain}" Margin="0,0,0,16"/>

        <!-- Секция COM-порта -->
        <Border Grid.Row="1" Background="{DynamicResource BgCard}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="COM-порт GSM-модема:" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextMain}" Margin="0,0,0,8"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="CmbPorts" Grid.Column="0" Height="34" FontSize="14" VerticalContentAlignment="Center"/>
                    <Button Grid.Column="1" Content="🔄" Click="BtnRefreshPorts_Click" Width="36" Height="34" Margin="8,0,0,0"
                            Background="#45475A" Foreground="#CDD6F4" BorderThickness="0" Cursor="Hand" ToolTip="Обновить список портов"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Секция резервного копирования -->
        <Border Grid.Row="2" Background="{DynamicResource BgCard}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Резервное копирование БД:" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextMain}" Margin="0,0,0,8"/>
                
                <TextBlock Text="Папка для бэкапов:" Foreground="{DynamicResource TextMuted}" FontSize="12" Margin="0,0,0,4"/>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="TxtBackupPath" Grid.Column="0" Height="30" FontSize="13" VerticalContentAlignment="Center" IsReadOnly="True" Background="{DynamicResource BgInner}" Foreground="{DynamicResource TextMain}" BorderThickness="0" Padding="5,0"/>
                    <Button Grid.Column="1" Content="📁" Click="BtnBrowseBackup_Click" Width="36" Height="30" Margin="8,0,0,0"
                            Background="#45475A" Foreground="#CDD6F4" BorderThickness="0" Cursor="Hand" ToolTip="Выбрать папку"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="💾 Создать бэкап" Click="BtnBackup_Click" Height="34" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    <Button Grid.Column="2" Content="📂 Восстановить" Click="BtnRestore_Click" Height="34" Background="#F9E2AF" Foreground="#11111B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </StackPanel>
        </Border>

        <!-- Секция обновления -->
        <Border Grid.Row="3" Background="{DynamicResource BgCard}" CornerRadius="8" Padding="14" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock Text="Обновление программы (GitHub):" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextMain}" Margin="0,0,0,8"/>
                
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <TextBlock Text="Текущая версия:" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,0,8,0"/>
                    <TextBlock x:Name="TxtCurrentVersion" Text="v1.0.0" FontWeight="Bold" Foreground="#89B4FA" FontSize="13"/>
                </StackPanel>

                <Button x:Name="BtnCheckUpdate" Content="🔍 Проверить обновления" Click="BtnCheckUpdate_Click"
                        Height="34" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" FontSize="13"
                        BorderThickness="0" Cursor="Hand" Margin="0,0,0,8"/>

                <TextBlock x:Name="TxtUpdateStatus" Text="Проверка не выполнялась" Foreground="{DynamicResource TextMuted}" 
                           FontSize="12" TextWrapping="Wrap"/>
                <ProgressBar x:Name="ProgressDownload" Height="6" Margin="0,6,0,0" Visibility="Collapsed" 
                             Foreground="#A6E3A1" Background="{DynamicResource BgInner}" BorderThickness="0"/>
            </StackPanel>
        </Border>

        <!-- Информационный блок о БД -->
        <Border Grid.Row="4" Background="{DynamicResource BgInner}" CornerRadius="6" Padding="10" VerticalAlignment="Top">
            <TextBlock x:Name="TxtDbInfo" Text="База данных: telemetry.db" Foreground="{DynamicResource TextMuted}" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- Кнопки сохранения/отмены -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <Button Content="Отмена" Click="BtnCancel_Click" Width="90" Height="34" Margin="0,0,10,0"
                    Background="#45475A" Foreground="#CDD6F4" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand"/>
            <Button Content="Сохранить" Click="BtnSave_Click" Width="100" Height="34"
                    Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>