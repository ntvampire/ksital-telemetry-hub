<Window x:Class="KsitalTelemetryHub.UI.Desktop.HistoryGraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="График температур объекта" Height="600" Width="950"
        Background="#1E1E2E" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="TxtTitle" Text="Динамика температур: Объект" 
                       Foreground="#ECEFF4" FontSize="18" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button Content="1 час" Click="BtnPeriod_Click" Tag="1" Margin="4,0" Padding="10,4" Background="#313244" Foreground="#CDD6F4" BorderThickness="0"/>
                <Button Content="6 часов" Click="BtnPeriod_Click" Tag="6" Margin="4,0" Padding="10,4" Background="#313244" Foreground="#CDD6F4" BorderThickness="0"/>
                <Button Content="24 часа" Click="BtnPeriod_Click" Tag="24" Margin="4,0" Padding="10,4" Background="#45475A" Foreground="#CDD6F4" FontWeight="Bold" BorderThickness="0"/>
                <Button Content="7 дней" Click="BtnPeriod_Click" Tag="168" Margin="4,0" Padding="10,4" Background="#313244" Foreground="#CDD6F4" BorderThickness="0"/>
            </StackPanel>
        </DockPanel>

        <!-- Легенда и статистика -->
        <Border Grid.Row="1" Background="#24273A" CornerRadius="6" Padding="12,8" Margin="0,0,0,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Rectangle Width="16" Height="4" Fill="#F38BA8" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="T1 (Подача)" Foreground="#F38BA8" FontWeight="Bold" Margin="0,0,20,0"/>

                    <Rectangle Width="16" Height="4" Fill="#89B4FA" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="T2 (Обратка)" Foreground="#89B4FA" FontWeight="Bold" Margin="0,0,20,0"/>
                </StackPanel>

                <TextBlock x:Name="TxtStats" DockPanel.Dock="Right" Foreground="#A6ADC8" VerticalAlignment="Center" FontSize="12"/>
            </DockPanel>
        </Border>

        <!-- Холст графика -->
        <Border Grid.Row="2" Background="#181825" CornerRadius="8" BorderBrush="#313244" BorderThickness="1" ClipToBounds="True">
            <Canvas x:Name="PlotCanvas" SizeChanged="PlotCanvas_SizeChanged"/>
        </Border>

        <!-- Подвал -->
        <TextBlock x:Name="TxtPointsCount" Grid.Row="3" Text="Загрузка..." Foreground="#6C7086" Margin="0,6,0,0" FontSize="11"/>
    </Grid>
</Window>