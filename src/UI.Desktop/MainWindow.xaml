<Window x:Class="KsitalTelemetryHub.UI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="КСИТАЛ GSM - Диспетчерский пункт телеметрии" Height="860" Width="1240"
        WindowStyle="None" WindowState="Maximized" ResizeMode="CanResize"
        Background="{DynamicResource BgMain}" Foreground="{DynamicResource TextMain}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="6"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="{DynamicResource BgHeader}" CornerRadius="8" Padding="12,8" Margin="0,0,0,10" MouseDown="Header_MouseDown">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,25,0">
                    <Image Source="app_logo.png" Width="28" Height="28" Margin="0,0,10,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="КСИТАЛ GSM - Диспетчерский пункт"
                               Foreground="{DynamicResource TextMain}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Кнопка Система -->
                <Button Content="⚙ Система" Click="BtnSettings_Click"
                        Background="#45475A" Foreground="#CDD6F4" FontSize="13" FontWeight="Bold"
                        Padding="12,6" BorderThickness="0" Margin="0,0,20,0" Cursor="Hand"/>

                <!-- Правая часть: звук, индикаторы и кнопки окна -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkSoundEnabled" Content="🔔 Звук" IsChecked="True"
                              Foreground="{DynamicResource TextMain}" FontSize="13" FontWeight="SemiBold"
                              VerticalAlignment="Center" Margin="0,0,15,0" Cursor="Hand"/>

                    <!-- Индикатор COM-порта -->
                    <Border Background="{DynamicResource BgInner}" CornerRadius="6" Padding="8,5" Margin="3,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LedComPort" Width="11" Height="11" Fill="#F38BA8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtComStatus" Text="COM: Отключен" Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>

                    <!-- Индикатор GSM-модема -->
                    <Border Background="{DynamicResource BgInner}" CornerRadius="6" Padding="8,5" Margin="3,0,15,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LedModem" Width="11" Height="11" Fill="#F38BA8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtModemStatus" Text="Модем: Нет" Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="Medium"/>
                        </StackPanel>
                    </Border>

                    <!-- Кнопки окна -->
                    <StackPanel Orientation="Horizontal">
                        <Button Content="🗕" Click="BtnMinimize_Click" ToolTip="Свернуть"
                                Width="32" Height="30" Background="Transparent" Foreground="{DynamicResource TextMain}"
                                FontSize="14" BorderThickness="0" Cursor="Hand" Margin="2,0"/>

                        <Button Content="🗖" Click="BtnMaximize_Click" ToolTip="Развернуть/Восстановить"
                                Width="32" Height="30" Background="Transparent" Foreground="{DynamicResource TextMain}"
                                FontSize="14" BorderThickness="0" Cursor="Hand" Margin="2,0"/>

                        <Button Content="✕" Click="BtnClose_Click" ToolTip="Закрыть программу"
                                Width="32" Height="30" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold"
                                FontSize="14" BorderThickness="0" Cursor="Hand" Margin="4,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Список объектов -->
        <GroupBox Grid.Row="1" Header="Контролируемые объекты по участкам (клик — открыть карточку, ПКМ — меню)" Foreground="{DynamicResource TextMain}" FontSize="14" FontWeight="Bold">
            <ListView x:Name="ListObjects" Background="{DynamicResource BgInner}" BorderThickness="0" Margin="0,6,0,0">
                <ListView.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="➕ Добавить новый объект" Click="MenuAddObject_Click"/>
                    </ContextMenu>
                </ListView.ContextMenu>

                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BorderColor}" CornerRadius="4" Padding="10,6" Margin="0,8,0,4">
                                    <TextBlock Text="{Binding Name}" Foreground="#F9E2AF" FontWeight="Bold" FontSize="15"/>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BgCard}" CornerRadius="8" Margin="0,4" Padding="12" Width="1160"
                                Cursor="Hand" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                            <Border.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="✏ Редактировать / Телеуправление" Click="MenuEditObject_Click" Tag="{Binding Id}"/>
                                    <MenuItem Header="➕ Добавить новый объект" Click="MenuAddObject_Click"/>
                                    <Separator/>
                                    <MenuItem Header="🗑 Удалить объект" Click="MenuDeleteObject_Click" Tag="{Binding Id}"/>
                                </ContextMenu>
                            </Border.ContextMenu>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="230"/>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="145"/>
                                    <ColumnDefinition Width="180"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="#89B4FA" FontWeight="Bold" FontSize="16"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{Binding Phone}" Foreground="{DynamicResource TextMuted}" FontSize="13"/>
                                        <TextBlock Text="{Binding DeviceTypeName}" Foreground="#CBA6F7" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>

                                <Border Grid.Column="1" Background="{DynamicResource BgInner}" CornerRadius="6" Margin="4" Padding="8,6">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="T1 (Подача)" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                        <TextBlock Text="{Binding TempT1}" Foreground="#F38BA8" FontWeight="Bold" FontSize="19"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="{DynamicResource BgInner}" CornerRadius="6" Margin="4" Padding="8,6">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="T2 (Обратка)" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                        <TextBlock Text="{Binding TempT2}" Foreground="#89B4FA" FontWeight="Bold" FontSize="19"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Background="{DynamicResource BgInner}" CornerRadius="6" Margin="4" Padding="8,6">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="T3 (Воздух)" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                        <TextBlock Text="{Binding TempT3}" Foreground="#A6E3A1" FontWeight="Bold" FontSize="19"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="12,0">
                                    <TextBlock Text="{Binding PowerStatus}" Foreground="{Binding PowerColor}" FontWeight="Bold" FontSize="14"/>
                                    <TextBlock Text="{Binding BatteryStatus}" Foreground="{DynamicResource TextMuted}" FontSize="13" Margin="0,2,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Content="📈 График" Click="BtnShowGraph_Click" Tag="{Binding Id}"
                                            Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" FontSize="13"
                                            Padding="12,5" Margin="0,0,0,4" BorderThickness="0" Cursor="Hand"/>
                                    <TextBlock Text="{Binding LastUpdate}" Foreground="{DynamicResource TextMuted}" FontSize="12" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox>

        <GridSplitter Grid.Row="2" Height="6" HorizontalAlignment="Stretch" Background="{DynamicResource BorderColor}"/>

        <!-- Нижняя панель: Вкладки Журнала тревог и Очереди команд -->
        <TabControl Grid.Row="3" Background="{DynamicResource BgInner}" BorderThickness="0" Margin="0,6,0,0">
            <!-- Вкладка 1: Журнал тревог -->
            <TabItem Header="🚨 Оперативный журнал тревог" FontSize="13" FontWeight="Bold">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="GridAlarms" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False"
                              Background="{DynamicResource BgInner}" RowBackground="{DynamicResource BgCard}"
                              Foreground="{DynamicResource TextMain}" FontSize="13"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                              BorderThickness="0" HeadersVisibility="Column" SelectionMode="Single" RowHeight="28">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource BgHeader}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="8,4"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Время" Binding="{Binding Timestamp, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}" Width="180"/>
                            <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="240"/>
                            <DataGridTextColumn Header="Описание тревоги" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="160"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Button Grid.Row="1" Content="Подтвердить выбранную тревогу"
                            Click="BtnAcknowledge_Click" Height="34" Margin="0,6,0,0" FontSize="13"
                            Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </Grid>
            </TabItem>

            <!-- Вкладка 2: Очередь команд -->
            <TabItem Header="📤 Очередь исходящих команд" FontSize="13" FontWeight="Bold">
                <Grid Margin="6">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Панель управления очередью -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="🔄 Обновить" Click="BtnRefreshCommands_Click"
                                Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"
                                Padding="12,5" Margin="0,0,10,0" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="🔁 Повторить сбойные" Click="BtnRetryFailedCommands_Click"
                                Background="#FAB387" Foreground="#11111B" FontWeight="Bold"
                                Padding="12,5" Margin="0,0,15,0" BorderThickness="0" Cursor="Hand"/>
                        <TextBlock x:Name="TxtCommandsSummary" Text="Всего: 0 | Ожидают: 0 | Отправлено: 0 | Ошибок: 0"
                                   VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}"/>
                    </StackPanel>

                    <!-- Таблица очереди -->
                    <DataGrid x:Name="GridCommands" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" Background="{DynamicResource BgInner}" RowBackground="{DynamicResource BgCard}"
                              Foreground="{DynamicResource TextMain}" FontSize="13"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                              BorderThickness="0" HeadersVisibility="Column" SelectionMode="Single" RowHeight="28">
                        <DataGrid.ColumnHeaderStyle>
                            <Style TargetType="DataGridColumnHeader">
                                <Setter Property="Background" Value="{DynamicResource BgHeader}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="Padding" Value="8,4"/>
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                            <DataGridTextColumn Header="Создано" Binding="{Binding CreatedAt, StringFormat='{}{0:dd.MM.yyyy HH:mm:ss}'}" Width="150"/>
                            <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="180"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding PhoneNumber}" Width="125"/>
                            <DataGridTextColumn Header="Команда" Binding="{Binding Description}" Width="180"/>
                            <DataGridTextColumn Header="SMS Payload" Binding="{Binding RawPayload}" Width="160"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="120"/>
                            <DataGridTextColumn Header="Отправлено" Binding="{Binding SentAtText}" Width="150"/>
                            <DataGridTextColumn Header="Информация / Ошибка" Binding="{Binding ErrorMessage}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>