<Window x:Class="KsitalTelemetryHub.UI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="КСИТАЛ GSM - Диспетчерский пункт телеметрии" Height="780" Width="1180"
        Background="{DynamicResource BgMain}" Foreground="{DynamicResource TextMain}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- Шапка: кнопка настроек и индикаторы -->
        <Border Grid.Row="0" Background="{DynamicResource BgHeader}" CornerRadius="8" Padding="12" Margin="0,0,0,12">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Диспетчерский пункт КСИТАЛ" 
                           Foreground="{DynamicResource TextMain}" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,20,0"/>

                <!-- Единая кнопка всех настроек -->
                <Button Content="⚙ Настройки системы" Click="BtnSettings_Click"
                        Background="#45475A" Foreground="#CDD6F4" FontWeight="SemiBold"
                        Padding="12,6" BorderThickness="0" Margin="0,0,20,0" Cursor="Hand"/>

                <!-- Индикаторы состояния связи и звук -->
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <CheckBox x:Name="ChkSoundEnabled" Content="🔔 Звук тревог" IsChecked="True"
                              Foreground="{DynamicResource TextMain}" FontSize="12" FontWeight="SemiBold"
                              VerticalAlignment="Center" Margin="0,0,15,0" Cursor="Hand"/>

                    <Border Background="{DynamicResource BgInner}" CornerRadius="6" Padding="8,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LedComPort" Width="10" Height="10" Fill="#F38BA8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtComStatus" Text="COM-порт: Отключен" Foreground="{DynamicResource TextMain}" FontSize="12"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BgInner}" CornerRadius="6" Padding="8,4" Margin="4,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="LedModem" Width="10" Height="10" Fill="#F38BA8" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="TxtModemStatus" Text="Модем: Нет связи" Foreground="{DynamicResource TextMain}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Список объектов -->
        <GroupBox Grid.Row="1" Header="Контролируемые объекты по участкам" Foreground="{DynamicResource TextMain}" FontSize="14" FontWeight="Bold">
            <ListView x:Name="ListObjects" Background="{DynamicResource BgInner}" BorderThickness="0" Margin="0,5,0,0">
                <ListView.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BorderColor}" CornerRadius="4" Padding="8,4" Margin="0,6,0,2">
                                    <TextBlock Text="{Binding Name}" Foreground="#F9E2AF" FontWeight="Bold" FontSize="14"/>
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListView.GroupStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource BgCard}" CornerRadius="8" Margin="0,3" Padding="10" Width="1100">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="#89B4FA" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="{Binding Phone}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                </StackPanel>

                                <Border Grid.Column="1" Background="{DynamicResource BgInner}" CornerRadius="6" Margin="4" Padding="6">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="T1 (Подача)" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                                        <TextBlock Text="{Binding TempT1}" Foreground="#F38BA8" FontWeight="Bold" FontSize="16"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Background="{DynamicResource BgInner}" CornerRadius="6" Margin="4" Padding="6">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="T2 (Обратка)" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                                        <TextBlock Text="{Binding TempT2}" Foreground="#89B4FA" FontWeight="Bold" FontSize="16"/>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="3" Background="{DynamicResource BgInner}" CornerRadius="6" Margin="4" Padding="6">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="T3 (Воздух)" Foreground="{DynamicResource TextMuted}" FontSize="10"/>
                                        <TextBlock Text="{Binding TempT3}" Foreground="#A6E3A1" FontWeight="Bold" FontSize="16"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding PowerStatus}" Foreground="{Binding PowerColor}" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text="{Binding BatteryStatus}" Foreground="{DynamicResource TextMuted}" FontSize="12"/>
                                </StackPanel>

                                <StackPanel Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Content="📈 График" Click="BtnShowGraph_Click" Tag="{Binding Id}"
                                            Background="#89B4FA" Foreground="#11111B" FontWeight="Bold"
                                            Padding="10,4" Margin="0,0,0,4" BorderThickness="0" Cursor="Hand"/>
                                    <TextBlock Text="{Binding LastUpdate}" Foreground="{DynamicResource TextMuted}" FontSize="11" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox>

        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="{DynamicResource BorderColor}"/>

        <!-- Журнал тревог (лимит 100) -->
        <GroupBox Grid.Row="3" Header="Оперативный журнал тревог (до 100 записей)" Foreground="{DynamicResource TextMain}" FontSize="14" FontWeight="Bold" Margin="0,5,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="GridAlarms" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="{DynamicResource BgInner}" RowBackground="{DynamicResource BgCard}"
                          Foreground="{DynamicResource TextMain}" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                          BorderThickness="0" HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время" Binding="{Binding Timestamp, StringFormat=\{0:dd.MM.yyyy HH:mm:ss\}}" Width="160"/>
                        <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="220"/>
                        <DataGridTextColumn Header="Описание тревоги" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="150"/>
                    </DataGrid.Columns>
                </DataGrid>

                <Button Grid.Row="1" Content="Квитировать (подтвердить) выбранную тревогу" 
                        Click="BtnAcknowledge_Click" Height="32" Margin="0,8,0,0"
                        Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" BorderThickness="0"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>