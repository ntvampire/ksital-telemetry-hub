<Window x:Class="KsitalTelemetryHub.UI.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="КСИТАЛ GSM - Диспетчерский пункт телеметрии" Height="720" Width="1100"
        Background="#1E1E2E" WindowStartupLocation="CenterScreen">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="3*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="2*"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Grid.Row="0" Background="#2B2B3D" CornerRadius="8" Padding="15,10" Margin="0,0,0,15">
            <DockPanel LastChildFill="False">
                <TextBlock Text="Диспетчерский мониторинг котельных и объектов" 
                           Foreground="#ECEFF4" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatus" Text="Подключение к БД..." 
                           Foreground="#88C0D0" FontSize="14" DockPanel.Dock="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Карточки технологических объектов -->
        <GroupBox Grid.Row="1" Header="Контролируемые объекты" Foreground="#D8DEE9" FontSize="14" FontWeight="Bold">
            <ListView x:Name="ListObjects" Background="#181825" BorderThickness="0" Margin="0,5,0,0">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#24273A" CornerRadius="8" Margin="0,4" Padding="12" Width="1020">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="220"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- Название и телефон -->
                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" Foreground="#89B4FA" FontWeight="Bold" FontSize="15"/>
                                    <TextBlock Text="{Binding Phone}" Foreground="#A6ADC8" FontSize="12"/>
                                </StackPanel>

                                <!-- Подача T1 -->
                                <Border Grid.Column="1" Background="#313244" CornerRadius="6" Margin="4" Padding="6">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="T1 (Подача)" Foreground="#A6ADC8" FontSize="10"/>
                                        <TextBlock Text="{Binding TempT1}" Foreground="#F38BA8" FontWeight="Bold" FontSize="16"/>
                                    </StackPanel>
                                </Border>

                                <!-- Обратка T2 -->
                                <Border Grid.Column="2" Background="#313244" CornerRadius="6" Margin="4" Padding="6">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="T2 (Обратка)" Foreground="#A6ADC8" FontSize="10"/>
                                        <TextBlock Text="{Binding TempT2}" Foreground="#89B4FA" FontWeight="Bold" FontSize="16"/>
                                    </StackPanel>
                                </Border>

                                <!-- Воздух T3 -->
                                <Border Grid.Column="3" Background="#313244" CornerRadius="6" Margin="4" Padding="6">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="T3 (Воздух)" Foreground="#A6ADC8" FontSize="10"/>
                                        <TextBlock Text="{Binding TempT3}" Foreground="#A6E3A1" FontWeight="Bold" FontSize="16"/>
                                    </StackPanel>
                                </Border>

                                <!-- Питание и АКБ -->
                                <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="10,0">
                                    <TextBlock Text="{Binding PowerStatus}" Foreground="{Binding PowerColor}" FontWeight="Bold" FontSize="13"/>
                                    <TextBlock Text="{Binding BatteryStatus}" Foreground="#BAC2DE" FontSize="12"/>
                                </StackPanel>

                                <!-- Время последнего обновления -->
                                <TextBlock Grid.Column="5" Text="{Binding LastUpdate}" Foreground="#6C7086" 
                                           HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </GroupBox>

        <!-- Разделитель -->
        <GridSplitter Grid.Row="2" Height="5" HorizontalAlignment="Stretch" Background="#313244"/>

        <!-- Журнал тревог -->
        <GroupBox Grid.Row="3" Header="Оперативный журнал тревог и инцидентов" Foreground="#D8DEE9" FontSize="14" FontWeight="Bold" Margin="0,5,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DataGrid x:Name="GridAlarms" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False"
                          Background="#181825" RowBackground="#24273A" AlternatingRowBackground="#1E1E2E"
                          Foreground="#CDD6F4" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244"
                          BorderThickness="0" HeadersVisibility="Column" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время" Binding="{Binding Timestamp, StringFormat=\{0:dd.MM.yyyy HH:mm:ss\}}" Width="160"/>
                        <DataGridTextColumn Header="Объект" Binding="{Binding ObjectName}" Width="200"/>
                        <DataGridTextColumn Header="Описание тревоги" Binding="{Binding Description}" Width="*"/>
                        <DataGridTextColumn Header="Статус" Binding="{Binding StatusText}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Кнопка квитирования -->
                <Button Grid.Row="1" Content="Квитировать (подтвердить) выбранную тревогу" 
                        Click="BtnAcknowledge_Click" Height="32" Margin="0,8,0,0"
                        Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" BorderThickness="0"/>
            </Grid>
        </GroupBox>
    </Grid>
</Window>