<Window x:Class="KsitalTelemetryHub.UI.Desktop.ManageObjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление объектами мониторинга" Height="520" Width="820"
        Background="#1E1E2E" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Таблица объектов -->
        <DataGrid x:Name="GridObjects" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False"
                  Background="#181825" RowBackground="#24273A" AlternatingRowBackground="#1E1E2E"
                  Foreground="#CDD6F4" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#313244"
                  SelectionChanged="GridObjects_SelectionChanged" SelectionMode="Single">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Район / Участок" Binding="{Binding District}" Width="160"/>
                <DataGridTextColumn Header="Наименование объекта" Binding="{Binding Name}" Width="220"/>
                <DataGridTextColumn Header="Телефон SIM" Binding="{Binding PhoneNumber}" Width="150"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Форма ввода и кнопки -->
        <Border Grid.Row="1" Background="#24273A" CornerRadius="8" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                    <TextBlock Text="Район / Участок:" Foreground="#A6ADC8" FontSize="11"/>
                    <TextBox x:Name="TxtDistrict" Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Padding="4"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                    <TextBlock Text="Наименование котельной:" Foreground="#A6ADC8" FontSize="11"/>
                    <TextBox x:Name="TxtName" Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Padding="4"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                    <TextBlock Text="Телефон SIM (+7...):" Foreground="#A6ADC8" FontSize="11"/>
                    <TextBox x:Name="TxtPhone" Background="#313244" Foreground="#CDD6F4" BorderThickness="0" Padding="4"/>
                </StackPanel>

                <!-- Кнопки действий -->
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,4,0">
                    <Button Content="Добавить новый" Click="BtnAdd_Click" Padding="12,6" Margin="4,0" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" BorderThickness="0"/>
                    <Button Content="Сохранить изменения" Click="BtnSave_Click" Padding="12,6" Margin="4,0" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" BorderThickness="0"/>
                    <Button Content="Удалить выбранный" Click="BtnDelete_Click" Padding="12,6" Margin="4,0" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" BorderThickness="0"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>