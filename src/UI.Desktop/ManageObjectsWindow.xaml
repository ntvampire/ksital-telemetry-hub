<Window x:Class="KsitalTelemetryHub.UI.Desktop.ManageObjectsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление объектами мониторинга" Height="580" Width="880"
        Background="{DynamicResource BgMain}" Foreground="{DynamicResource TextMain}"
        FontSize="14" WindowStartupLocation="CenterOwner">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DataGrid x:Name="GridObjects" Grid.Row="0" AutoGenerateColumns="False" CanUserAddRows="False"
                  Background="{DynamicResource BgInner}" RowBackground="{DynamicResource BgCard}"
                  Foreground="{DynamicResource TextMain}" FontSize="13" RowHeight="28"
                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource BorderColor}"
                  SelectionChanged="GridObjects_SelectionChanged" SelectionMode="Single">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="{DynamicResource BgHeader}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextMain}"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="13"/>
                    <Setter Property="Padding" Value="8,4"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                <DataGridTextColumn Header="Район / Участок" Binding="{Binding District}" Width="200"/>
                <DataGridTextColumn Header="Наименование объекта" Binding="{Binding Name}" Width="240"/>
                <DataGridTextColumn Header="Телефон SIM" Binding="{Binding PhoneNumber}" Width="160"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="1" Background="{DynamicResource BgCard}" CornerRadius="8" Padding="14" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                    <TextBlock Text="Район / Участок:" Foreground="{DynamicResource TextMuted}" FontSize="13"/>
                    <TextBox x:Name="TxtDistrict" Height="30" VerticalContentAlignment="Center" Background="{DynamicResource BgInner}" Foreground="{DynamicResource TextMain}" BorderBrush="{DynamicResource BorderColor}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                    <TextBlock Text="Наименование котельной:" Foreground="{DynamicResource TextMuted}" FontSize="13"/>
                    <TextBox x:Name="TxtName" Height="30" VerticalContentAlignment="Center" Background="{DynamicResource BgInner}" Foreground="{DynamicResource TextMain}" BorderBrush="{DynamicResource BorderColor}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                    <TextBlock Text="Телефон SIM (+7...):" Foreground="{DynamicResource TextMuted}" FontSize="13"/>
                    <TextBox x:Name="TxtPhone" Height="30" VerticalContentAlignment="Center" Background="{DynamicResource BgInner}" Foreground="{DynamicResource TextMain}" BorderBrush="{DynamicResource BorderColor}" Margin="0,4,0,0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,4,0">
                    <Button Content="Добавить новый" Click="BtnAdd_Click" Padding="14,8" Margin="5,0" FontSize="14" Background="#A6E3A1" Foreground="#11111B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Сохранить изменения" Click="BtnSave_Click" Padding="14,8" Margin="5,0" FontSize="14" Background="#89B4FA" Foreground="#11111B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                    <Button Content="Удалить выбранный" Click="BtnDelete_Click" Padding="14,8" Margin="5,0" FontSize="14" Background="#F38BA8" Foreground="#11111B" FontWeight="Bold" BorderThickness="0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>